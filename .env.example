# MARSA – sample environment configuration (no real credentials)
PORT=8080
MARSA_DB=./data/marsa-v4.db
MARSA_DEMO=1
# Proposed integrations – not connected in the MVP. Fill only with officially issued access.
MARSA_INTEGRATION_KEY=change-me
MARSA_NCM_API_URL=
MARSA_NCM_API_KEY=
MARSA_AIS_API_URL=
MARSA_AIS_API_KEY=
MARSA_PORTS_API_URL=
MARSA_NAVTEX_ENDPOINT=
MARSA_NAVAREA_ENDPOINT=
# Web Push (VAPID). Either set both keys (generate: node -e "console.log(require('./server/push.js').generateVapidKeys())")
# or a long random MARSA_VAPID_SEED (keys are derived from it and stay stable across restarts). Never put the private key in the frontend.
MARSA_VAPID_PUBLIC_KEY=
MARSA_VAPID_PRIVATE_KEY=
MARSA_VAPID_SEED=
MARSA_VAPID_SUBJECT=mailto:ops@example.invalid
